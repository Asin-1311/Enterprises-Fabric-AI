# Copy this file to .env and fill in real values. Never commit .env.

# --- Option A (used by this project): OpenRouter ---
LLM_BASE_URL=https://openrouter.ai/api
LLM_AUTH_TOKEN=sk-or-v1-replace-me
MODEL_LIGHT=anthropic/claude-haiku-5.5
MODEL_SYNTH=anthropic/claude-sonnet-5.5
MODEL_VERIFY=anthropic/claude-opus-5.5

# --- Option B: direct Anthropic API (comment out Option A) ---
# ANTHROPIC_API_KEY=sk-ant-replace-me
# MODEL_LIGHT=claude-haiku-5-5
# MODEL_SYNTH=claude-sonnet-5-5
# MODEL_VERIFY=claude-opus-5-5

# MODEL_VERIFY must differ from MODEL_SYNTH.

# Effort per role (low | medium | high | xhigh | max). Replaces temperature,
# which these models no longer accept.
# EFFORT_LIGHT=low
# EFFORT_SYNTH=medium
# EFFORT_VERIFY=medium

# Sign-in: initial password for the synthetic demo users (emails in data/users.csv,
# e.g. riya.kapoor@example-associates.test). At least 8 characters. Choose your own;
# it is applied only to demo users who have no password yet.
DEMO_PASSWORD=choose-a-demo-password
# SESSION_HOURS=8
# RESET_LINK_MINUTES=15
# Self-registration is OFF unless you switch it on; when on, only this domain may register.
# ALLOW_SELF_REGISTRATION=false
# SELF_REGISTRATION_DOMAIN=example-associates.test
# Sign-in protection per client IP: calls a minute to /auth/*, and a lockout after
# repeated failed sign-ins.
# AUTH_RATE_PER_MINUTE=5
# AUTH_LOCKOUT_FAILURES=10
# AUTH_LOCKOUT_MINUTES=15

# --- Run profile (CLAUDE.md section 2) ---
# lite (default): SQLite, embedded Qdrant, in-memory BM25; nothing else to install.
# full: the servers in deploy/compose.yaml (needs Docker and requirements-full.txt).
# PROFILE=lite
# Credentials for the PostgreSQL container (choose your own password; .env is not in git):
# POSTGRES_USER=fabric
# POSTGRES_PASSWORD=choose-a-local-password
# POSTGRES_DB=fabric
# Where the app finds the full-profile servers (all on 127.0.0.1):
# DATABASE_URL=postgresql+psycopg://fabric:choose-a-local-password@127.0.0.1:5432/fabric
# QDRANT_URL=http://127.0.0.1:6333
# OPENSEARCH_URL=http://127.0.0.1:9200
# REDIS_URL=redis://127.0.0.1:6379/0
# KAFKA_BOOTSTRAP=127.0.0.1:9092
# MinIO (S3 connector, M12c). The S3 source refers to these as "env:MINIO_ROOT_USER" and
# "env:MINIO_ROOT_PASSWORD" (local development only: production would use a read-only key).
# MINIO_ROOT_USER=fabric
# MINIO_ROOT_PASSWORD=choose-a-local-password-of-8-or-more-characters

# --- Connectors (M12c) ---
# How often git, s3, confluence, jira and sharepoint sources are checked, and whether the
# API process runs that poller (set false when it runs as its own process in full).
# CONNECTOR_POLL_SECONDS=30
# API_RUN_CONNECTORS=true
# Failed batches are retried this many times, then failing events go to doc-changes-dead
# (replay with: python -m app.ingest.worker --replay-dead-letters).
# WORKER_MAX_ATTEMPTS=5

# Optional overrides (defaults live in app/config.py)
# CHUNK_MAX_TOKENS=400
# CHUNK_OVERLAP_TOKENS=50
# RRF_K=60
# RERANK_TOP_N=5
# MIN_GOOD_CHUNKS=3
# GOOD_CHUNK_THRESHOLD=0.3
# CONFIDENCE_THRESHOLD=0.6

# --- Policy and data handling (M13a) ---
# Per-chunk access decisions after retrieval: auto = OPA in full, the same rules in code
# in lite (start OPA with: docker compose ... --profile identity up -d).
# POLICY_ENGINE=auto
# OPA_URL=http://127.0.0.1:8181
# Traces and retrieval records older than this are purged nightly (audit_log never is).
# TRACE_RETENTION_DAYS=90
# The private model for documents classified "restricted" (Ollama). Leave empty and
# restricted material is refused instead of being sent to an external model.
# PRIVATE_MODEL=qwen2.5:1.5b
# OLLAMA_URL=http://127.0.0.1:11434

# --- Identity (M13b): Keycloak, full profile ---
# Who signs users in: auto = Keycloak JWTs in full, email/password in lite.
# AUTH_MODE=auto
# OIDC_ISSUER=http://127.0.0.1:8180/realms/fabric
# OIDC_AUDIENCE=fabric-api
# Keycloak's bootstrap administrator and the demo users' password (set by
# scripts/keycloak_setup.py; the realm file in git holds no passwords).
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=choose-a-local-password
# KEYCLOAK_DEMO_PASSWORD=choose-a-local-password

# --- Agent plane (M14a) ---
# Light path for simple factual questions (fewer candidates, no compression), and how many
# section chunks exploratory questions may add around their best chunks (small-to-big).
# LIGHT_TOP_K=10
# PARENT_EXPANSION_MAX=6
# Step budgets per question; a run that would pass one ends with the best verified answer
# so far, or an abstention.
# BUDGET_MAX_LLM_CALLS=12
# BUDGET_MAX_TOKENS=60000
# BUDGET_MAX_SECONDS=90
# BUDGET_MAX_RETRIEVAL_ROUNDS=3

# --- Verification (M14b) ---
# The NLI model that gives verification its second opinion (empty: LLM verifier only).
# NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# NLI_ENTAILMENT_THRESHOLD=0.5
# NLI_CONTRADICTION_THRESHOLD=0.5

# --- Adaptive retrieval (M15a) ---
# Retriever weights and candidates per retriever by question type (starting points; the
# candidate count for factual/procedural questions was measured on the evaluation set).
# PRECISE_DENSE_WEIGHT=0.4
# PRECISE_KEYWORD_WEIGHT=0.6
# PRECISE_TOP_K=20
# EXPLORATORY_DENSE_WEIGHT=0.6
# EXPLORATORY_KEYWORD_WEIGHT=0.4
# EXPLORATORY_TOP_K=30
# Source-freshness boost for time-sensitive questions.
# SOURCE_FRESHNESS_WEIGHT=0.1
# SOURCE_FRESHNESS_WINDOW_DAYS=30
# Degradation under load: p95 of full-answer time over the last N answers vs the target.
# DEGRADATION_ENABLED=true
# LATENCY_TARGET_SECONDS=8
# LATENCY_WINDOW_SIZE=100
# LATENCY_MIN_SAMPLES=20
# DEGRADED_CANDIDATE_FACTOR=0.5
